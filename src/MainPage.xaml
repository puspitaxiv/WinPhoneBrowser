<Page
    x:Class="WPMobileBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="4" Background="#102A43">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBack" Grid.Column="0" Content="←" Click="BtnBack_Click" Padding="10,0" />
            <Button x:Name="BtnForward" Grid.Column="1" Content="→" Click="BtnForward_Click" Padding="10,0" />
            <Button x:Name="BtnHome" Grid.Column="2" Content="⌂" Click="BtnHome_Click" Padding="10,0" />
            <TextBox x:Name="UrlBox" Grid.Column="3"
                     PlaceholderText="ketik alamat web, mis. bing.com"
                     KeyDown="UrlBox_KeyDown" Margin="4,0"
                     VerticalAlignment="Center" />
            <Button x:Name="BtnGo" Grid.Column="4" Content="Buka" Click="BtnGo_Click" />
        </Grid>

        <Grid Grid.Row="1">
            <WebView x:Name="Web" NavigationStarting="Web_NavigationStarting" NavigationCompleted="Web_NavigationCompleted" />
            <ProgressBar x:Name="Bar" Height="4" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
